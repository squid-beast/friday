<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jarvis.screenpipe</string>
	<key>ProgramArguments</key>
	<array>
		<string>__SCREENPIPE__</string>
		<!-- recall reads frames+OCR only; the audio pipeline crash-looped on
		     whisper downloads and re-triggered permission prompts every respawn -->
		<string>--disable-audio</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__STATE__/logs/screenpipe.log</string>
	<key>StandardErrorPath</key>
	<string>__STATE__/logs/screenpipe.log</string>
</dict>
</plist>
