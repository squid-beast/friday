<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.friday.checkin</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>cd "__REPO__" &amp;&amp; exec "__UV__" run python -m scripts.proactive_checkin</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<!-- a scheduled nudge, NOT at load: reinstalling/logging in must never spam -->
	<key>RunAtLoad</key>
	<false/>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__STATE__/logs/checkin.log</string>
	<key>StandardErrorPath</key>
	<string>__STATE__/logs/checkin.log</string>
</dict>
</plist>
