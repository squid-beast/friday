<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jarvis.killswitch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>cd "__REPO__" &amp;&amp; "__UV__" run python -m scripts.healthcheck --quick; exec "__UV__" run python -m client.killswitch</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<!-- The always-on wake-word models are tiny; fanning their ONNX/BLAS ops
		     across every core costs more in dispatch than it saves. Pin to 1
		     thread each — lower CPU for the DORMANT listener, no accuracy change. -->
		<key>OMP_NUM_THREADS</key>
		<string>1</string>
		<key>OPENBLAS_NUM_THREADS</key>
		<string>1</string>
		<key>VECLIB_MAXIMUM_THREADS</key>
		<string>1</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__STATE__/logs/killswitch.log</string>
	<key>StandardErrorPath</key>
	<string>__STATE__/logs/killswitch.log</string>
</dict>
</plist>
