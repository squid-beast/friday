# Copy to .env. Never share, never commit, never snapshot off-machine.
# Every field in config/settings.py is listed here (secrets blank). Rules:
# comments on their own line (inline comments parse as values); quote values
# containing spaces (launchd sources this file with bash).

# Product identity
ASSISTANT_NAME=Friday
# the phrase you WANT; the header shows the bundled fallback until a model is trained
WAKE_PHRASE_TEXT="Hey Friday"
STAND_DOWN_PHRASE_TEXT="Stand Down"

# LLM (real model IDs)
ANTHROPIC_API_KEY=
MODEL_SMART=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5

# Voice
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
TTS_VOICE_ID=
# optional fallback
ELEVENLABS_API_KEY=

# LiveKit local
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
# openssl rand -hex 32
LIVEKIT_API_SECRET=

# Runtime state root (outside the repo); relative paths below resolve under it
FRIDAY_STATE_DIR="~/Library/Application Support/Friday"

# Runtime memory
VAULT_PATH=/Users/lohithkumar/leos-brain
# comma-separated vault-relative folders Friday must never read
VAULT_EXCLUDE=
# embedded chroma store
CHROMA_PATH=db/chroma
# LangGraph conversation checkpoints
CHECKPOINT_DB_PATH=db/checkpoint.db
# the audit trail ("what did you do today?")
AUDIT_DB_PATH=db/audit.db

# Jobs command center — the job engine's output folder + tracker note (inside VAULT_PATH)
JOBS_DIR=/Users/lohithkumar/Downloads/Jobs
JOBS_TRACKER_NOTE=areas/career/target-companies.md

# n8n (tailnet base URL; webhooks authed with the X-Friday-Secret header)
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# n8n public REST API key — reads executions for the HUD automations card
N8N_API_KEY=

# Vision — screen recall (screenpipe; launchd agent removed, dark by design)
SCREENPIPE_URL=http://127.0.0.1:3030
# comma-separated app names never surfaced in recall (suggest: banking apps, WhatsApp)
SCREENPIPE_EXCLUDE=
# Vision — camera (Moondream Station; launchd agent removed, dark by design)
MOONDREAM_ENDPOINT=http://127.0.0.1:2020/v1
# each real camera frame is saved here for the dashboard; keep the newest N
VISION_SNAPS_DIR=images/vision/snaps
VISION_SNAPS_KEEP=20
# offline cut flags: camera / screen recall refuse while the file exists
CAMERA_OFF_FILE=control/camera_off
SCREEN_OFF_FILE=control/screen_off
# gesture agent files: latest landmarks, live frame, cursor-control armed flag
GESTURE_STATE_FILE=gesture/state.json
GESTURE_FRAME_FILE=gesture/frame.jpg
GESTURE_CONTROL_FILE=gesture/control_on
# dedicated Chrome profile for browser tasks (never your own)
BROWSER_PROFILE_DIR=~/friday-chrome
BROWSER_MAX_STEPS=15
CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Sessions
SESSION_SILENCE_TIMEOUT_S=120
WAKE_THRESHOLD=0.6
# blank = bundled "Hey Jarvis" fallback model; train yours: voice/wakeword/README.md
WAKE_MODEL_PATH=
# strict owner-voice lock on the wake phrase (.joblib from scripts/train_voice_verifier.py)
WAKE_VERIFIER_PATH=
WAKE_VERIFIER_THRESHOLD=0.18
# true = wake fails closed until WAKE_VERIFIER_PATH exists
WAKE_REQUIRE_VERIFIER=false
# blank = spoken offline kill unarmed; menu-bar always works
KILL_MODEL_PATH=
# blank = global kill hotkey OFF; e.g. cmd+alt+j re-enables it (needs Accessibility)
HOTKEY=
# the agent touches this; the daemon ends the session on it
STAND_DOWN_FILE=control/stand_down

# Wake routine — open apps/tabs on wake (also "open my apps")
WAKE_APPS_ENABLED=true
WAKE_LAUNCH_SPOTIFY=true
# comma-separated; last one is the Friday dashboard
WAKE_URLS=https://www.instagram.com,https://github.com,https://mail.google.com,http://127.0.0.1:8787

# Highest-risk gate — spoken 4-digit PIN for risk=pin tools; blank = locked shut
FRIDAY_PIN=

# Calls (PIN-gated) — Friday phones someone for you. See docs/CALLS.md.
# provider: vapi | twilio | blank(=refuses)
TELEPHONY_PROVIDER=
TELEPHONY_API_KEY=
TELEPHONY_FROM_NUMBER=
TELEPHONY_AGENT_ID=

# Weather (Open-Meteo, keyless) — home city; quote multi-word names
WEATHER_CITY=

# Dashboard (127.0.0.1 only)
DASHBOARD_PORT=8787
LOGS_DIR=logs
# access key for the app behind tailscale serve/funnel; blank = open (localhost only)
# generate: openssl rand -hex 16
APP_ACCESS_KEY=

# Content Studio — n8n workflows (docs/archive/CONTENT-STUDIO.md); IG creds stay in n8n
# e.g. /webhook/content-trending
CONTENT_TRENDING_WEBHOOK=
# e.g. /webhook/content-publish
CONTENT_PUBLISH_WEBHOOK=
CONTENT_DB_PATH=db/content.db
METRICS_DB_PATH=db/metrics.db
# spoken reminders store + simulated-mood state
REMINDERS_PATH=db/reminders.json
MOOD_PATH=db/mood.json

# Phone voice (docs/MOBILE.md) — tailnet only, never public
# the Mac's tailscale IP (tailscale ip -4); blank = loopback only
LIVEKIT_BIND_IP=
# same tailscale IP — media ICE candidate for the phone
LIVEKIT_NODE_IP=
# wss://<mac>.<tailnet>.ts.net:8443 (tailscale serve -> 7880)
VOICE_WS_URL=

# Observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=friday
