# Copy to .env. Never share, never snapshot off-machine. See PLAN.md §6.
# LLM (PLAN's claude-*-latest aliases don't exist — these are real model IDs)
ANTHROPIC_API_KEY=
MODEL_SMART=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5
# Voice
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
TTS_VOICE_ID=
# optional fallback
ELEVENLABS_API_KEY=
# LiveKit local
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
# openssl rand -hex 32
LIVEKIT_API_SECRET=
# Runtime state root (outside the repo)
FRIDAY_STATE_DIR=~/Library/Application Support/Friday
# Runtime memory
VAULT_PATH=/Users/lohithkumar/leos-brain
# comma-separated vault-relative folders Jarvis must never read
VAULT_EXCLUDE=
# embedded chroma store (relative paths resolve under FRIDAY_STATE_DIR)
CHROMA_PATH=db/chroma
# n8n (Phase 4)
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# Vision (Phase 5)
SCREENPIPE_URL=http://127.0.0.1:3030
# comma-separated app names (suggest: banking apps, WhatsApp)
SCREENPIPE_EXCLUDE=
# Moondream Station (local)
MOONDREAM_ENDPOINT=http://127.0.0.1:2020/v1
# dedicated Chrome profile for browser tasks
BROWSER_PROFILE_DIR=~/jarvis-chrome
BROWSER_MAX_STEPS=15
# Sessions
SESSION_SILENCE_TIMEOUT_S=120
WAKE_THRESHOLD=0.6
# blank = bundled "hey jarvis"; train yours: voice/wakeword/README.md
WAKE_MODEL_PATH=
# blank = spoken offline kill unarmed; hotkey/menu-bar always work
KILL_MODEL_PATH=
# ⌥⌘J global kill
HOTKEY=cmd+alt+j
# Highest-risk gate
# spoken 4-digit PIN for risk=pin tools; blank = locked shut
JARVIS_PIN=
# Wake routine — open apps/tabs on the FIRST wake of the day (also "open my apps")
WAKE_APPS_ENABLED=true
WAKE_LAUNCH_SPOTIFY=true
# comma-separated; last one is the Jarvis cockpit UI
WAKE_URLS=https://www.instagram.com,https://github.com,https://mail.google.com,http://127.0.0.1:8787
# Calls (PIN-gated) — Jarvis phones someone for you. See docs/CALLS.md.
# provider: vapi | twilio | blank(=refuses)
TELEPHONY_PROVIDER=
TELEPHONY_API_KEY=
TELEPHONY_FROM_NUMBER=
TELEPHONY_AGENT_ID=
# Dashboard (127.0.0.1 only)
DASHBOARD_PORT=8787
# Content Studio — n8n workflows (docs/archive/CONTENT-STUDIO.md); IG creds stay in n8n
# e.g. /webhook/content-trending
CONTENT_TRENDING_WEBHOOK=
# e.g. /webhook/content-publish
CONTENT_PUBLISH_WEBHOOK=
# Phone voice (Phase 7.6, docs/MOBILE.md) — tailnet only, never public
# the Mac's tailscale IP (tailscale ip -4); blank = loopback only
LIVEKIT_BIND_IP=
# same tailscale IP — media ICE candidate for the phone
LIVEKIT_NODE_IP=
# wss://<mac>.<tailnet>.ts.net:8443 (tailscale serve -> 7880)
VOICE_WS_URL=
# Observability (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jarvis
